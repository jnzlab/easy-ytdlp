{
  "name": "@jnzlab/easy-ytdlp",
  "version": "1.2.0",
  "description": "A user-friendly interactive CLI wrapper for yt-dlp — no Python or flag memorization required",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "easy-ytdlp": "bin/easy-ytdlp.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean --outDir dist",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "yt-dlp",
    "youtube",
    "download",
    "cli",
    "video"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnzlab/easy-ytdlp.git"
  },
  "homepage": "https://github.com/jnzlab/easy-ytdlp#readme",
  "bugs": {
    "url": "https://github.com/jnzlab/easy-ytdlp/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "cli-progress": "^3.12.0",
    "commander": "^13.1.0",
    "env-paths": "^3.0.0",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
